  <mapsources>
    <mapsource name='Tableau' />
  </mapsources>
  <actions>
    <action caption='Open on ClinicalTrials.gov' name='[Action1_OpenStudy]'>
      <activation type='on-select' />
      <source dashboard='Trial Scout' type='sheet' worksheet='Candidate Trials' />
      <link caption='' expression='https://clinicaltrials.gov/study/&lt;[nct_id]&gt;' />
    </action>
    <datasources>
      <datasource caption='Trial Scout' name='federated.scout' />
    </datasources>
    <datasource-dependencies datasource='federated.scout'>
      <column caption='NCT ID' datatype='string' name='[nct_id]' role='dimension' type='nominal' />
    </datasource-dependencies>
  </actions>
  <worksheets>
    <worksheet name="Patient Facts">
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#184f95' fontsize='13'>Selected patient</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Trial Scout' name='federated.scout' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Patient' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;PID-001&quot;'>
              <calculation class='tableau' formula='&quot;PID-001&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.scout'>
            <column caption="Patient" datatype='string' name='[Patient_ID]' role='dimension' type='nominal' />
            <column caption='Selected Patient' datatype='boolean' name='[Selected Patient]' role='dimension' type='nominal'><calculation class='tableau' formula='[Patient_ID] = [Parameters].[Parameter 1]' /></column>
            <column caption='Patient Summary' datatype='string' name='[Patient Summary]' role='dimension' type='nominal'><calculation class='tableau' formula='[AI_Predicted_Condition] + &quot;  |  Age &quot; + STR([Patient_Age]) + &quot;  |  &quot; + [Patient_Sex] + &quot;  |  &quot; + [Patient_Location] + &quot;  |  &quot; + [Disease_Setting] + &quot;  |  EGFR &quot; + [Biomarker_EGFR] + &quot;  |  IDH &quot; + [Biomarker_IDH] + &quot;  |  MGMT &quot; + [Biomarker_MGMT]' /></column>
            <column-instance column='[Selected Patient]' derivation='None' name='[none:Selected Patient:nk]' pivot='key' type='nominal' />
            <column-instance column='[Patient Summary]' derivation='None' name='[none:Patient Summary:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.scout].[none:Selected Patient:nk]'>
            <groupfilter function='member' level='[none:Selected Patient:nk]' member='true' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.scout].[none:Selected Patient:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='header'>
            <format attr='width' field='[federated.scout].[none:Patient Summary:nk]' value='1150' />
          </style-rule>
          <style-rule element='worksheet'>
            <format attr='display-field-labels' scope='rows' value='false' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />


          </pane>
        </panes>
        <rows>[federated.scout].[none:Patient Summary:nk]</rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name="Candidate Trials">
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#184f95' fontsize='13'>Candidate trials, best first. Click a trial to open it on ClinicalTrials.gov.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Trial Scout' name='federated.scout' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Patient' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;PID-001&quot;'>
              <calculation class='tableau' formula='&quot;PID-001&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.scout'>
            <column caption="Patient" datatype='string' name='[Patient_ID]' role='dimension' type='nominal' />
            <column caption='Selected Patient' datatype='boolean' name='[Selected Patient]' role='dimension' type='nominal'><calculation class='tableau' formula='[Patient_ID] = [Parameters].[Parameter 1]' /></column>
            <column caption="Rank" datatype='integer' name='[patient_rank]' role='dimension' type='ordinal' />
            <column caption="Score" datatype='integer' name='[match_score]' role='dimension' type='ordinal' />
            <column caption="Tier" datatype='string' name='[match_tier]' role='dimension' type='nominal' />
            <column caption="Trial" datatype='string' name='[trial_title]' role='dimension' type='nominal' />
            <column caption="NCT ID" datatype='string' name='[nct_id]' role='dimension' type='nominal' />
            <column caption="Status" datatype='string' name='[status]' role='dimension' type='nominal' />
            <column caption="Nearest site" datatype='string' name='[best_site]' role='dimension' type='nominal' />
            <column caption="Why it matches" datatype='string' name='[match_reasons]' role='dimension' type='nominal' />
            <column caption="Distance" datatype='string' name='[distance]' role='dimension' type='nominal' />
            <column-instance column='[Selected Patient]' derivation='None' name='[none:Selected Patient:nk]' pivot='key' type='nominal' />
            <column-instance column='[patient_rank]' derivation='None' name='[none:patient_rank:ok]' pivot='key' type='ordinal' />
            <column-instance column='[match_score]' derivation='None' name='[none:match_score:ok]' pivot='key' type='ordinal' />
            <column-instance column='[match_tier]' derivation='None' name='[none:match_tier:nk]' pivot='key' type='nominal' />
            <column-instance column='[trial_title]' derivation='None' name='[none:trial_title:nk]' pivot='key' type='nominal' />
            <column-instance column='[nct_id]' derivation='None' name='[none:nct_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' />
            <column-instance column='[best_site]' derivation='None' name='[none:best_site:nk]' pivot='key' type='nominal' />
            <column-instance column='[match_reasons]' derivation='None' name='[none:match_reasons:nk]' pivot='key' type='nominal' />
            <column-instance column='[distance]' derivation='None' name='[none:distance:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.scout].[none:Selected Patient:nk]'>
            <groupfilter function='member' level='[none:Selected Patient:nk]' member='true' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.scout].[none:match_tier:nk]'>
            <groupfilter function='level-members' level='[none:match_tier:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.scout].[none:distance:nk]'>
            <groupfilter function='level-members' level='[none:distance:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.scout].[none:Selected Patient:nk]</column>
            <column>[federated.scout].[none:match_tier:nk]</column>
            <column>[federated.scout].[none:distance:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='header'>
            <format attr='width' field='[federated.scout].[none:trial_title:nk]' value='330' />
            <format attr='width' field='[federated.scout].[none:nct_id:nk]' value='95' />
            <format attr='width' field='[federated.scout].[none:best_site:nk]' value='170' />
            <format attr='width' field='[federated.scout].[none:match_reasons:nk]' value='330' />
            <format attr='width' field='[federated.scout].[none:status:nk]' value='120' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />


          </pane>
        </panes>
        <rows>([federated.scout].[none:patient_rank:ok] / [federated.scout].[none:match_score:ok] / [federated.scout].[none:match_tier:nk] / [federated.scout].[none:trial_title:nk] / [federated.scout].[none:nct_id:nk] / [federated.scout].[none:status:nk] / [federated.scout].[none:best_site:nk] / [federated.scout].[none:match_reasons:nk])</rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name="Trial Sites">
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#184f95' fontsize='13'>Nearest site of each candidate trial</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Trial Scout' name='federated.scout' />
            <datasource name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Patient' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;PID-001&quot;'>
              <calculation class='tableau' formula='&quot;PID-001&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.scout'>
            <column caption="Patient" datatype='string' name='[Patient_ID]' role='dimension' type='nominal' />
            <column caption='Selected Patient' datatype='boolean' name='[Selected Patient]' role='dimension' type='nominal'><calculation class='tableau' formula='[Patient_ID] = [Parameters].[Parameter 1]' /></column>
            <column caption='Candidates' datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'><calculation class='tableau' formula='1' /></column>
            <column caption="City" datatype='string' name='[site_city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption="State" datatype='string' name='[site_state]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column caption="Country" datatype='string' name='[site_country]' role='dimension' semantic-role='[Country].[Name]' type='nominal' />
            <column-instance column='[Selected Patient]' derivation='None' name='[none:Selected Patient:nk]' pivot='key' type='nominal' />
            <column-instance column='[site_city]' derivation='None' name='[none:site_city:nk]' pivot='key' type='nominal' />
            <column-instance column='[site_state]' derivation='None' name='[none:site_state:nk]' pivot='key' type='nominal' />
            <column-instance column='[site_country]' derivation='None' name='[none:site_country:nk]' pivot='key' type='nominal' />
            <column-instance column='[Number of Records]' derivation='Sum' name='[sum:Number of Records:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.scout].[none:Selected Patient:nk]'>
            <groupfilter function='member' level='[none:Selected Patient:nk]' member='true' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.scout].[none:Selected Patient:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='map'>
            <format attr='washout' value='0.0' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Circle' />
            <encodings>
              <lod column='[federated.scout].[none:site_city:nk]' />
              <lod column='[federated.scout].[none:site_state:nk]' />
              <lod column='[federated.scout].[none:site_country:nk]' />
              <size column='[federated.scout].[sum:Number of Records:qk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text><run bold='true'>&lt;[federated.scout].[none:site_city:nk]&gt;, &lt;[federated.scout].[none:site_state:nk]&gt;</run><run>&#10;Candidate trials with a site here: &lt;[federated.scout].[sum:Number of Records:qk]&gt;</run></formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='mark'>
                <format attr='mark-color' value='#184f95' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.scout].[Latitude (generated)]</rows>
        <cols>[federated.scout].[Longitude (generated)]</cols>
      </table>
    </worksheet>
    <worksheet name="Candidates by Tier">
      <layout-options>
