    <datasource caption="Trial Scout" inline='true' name='federated.scout' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption="trial_scout.csv" name='textscan.scout'>
            <connection class='textscan' directory="C:/Users/deipt/Downloads/Elif/hippocrates/Hippocrates-Analytics-Clinical-Trial-Matching-Optimization-main/tableau" filename="trial_scout.csv" password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.scout' name="trial_scout.csv" table='[trial_scout#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','>
            <column datatype='string' name="Patient_ID" ordinal='0' />
            <column datatype='string' name="nct_id" ordinal='1' />
            <column datatype='string' name="trial_title" ordinal='2' />
            <column datatype='integer' name="match_score" ordinal='3' />
            <column datatype='string' name="match_tier" ordinal='4' />
            <column datatype='string' name="condition_match" ordinal='5' />
            <column datatype='string' name="geography" ordinal='6' />
            <column datatype='string' name="best_site" ordinal='7' />
            <column datatype='integer' name="sites_in_country" ordinal='8' />
            <column datatype='string' name="status" ordinal='9' />
            <column datatype='string' name="phases" ordinal='10' />
            <column datatype='string' name="study_type" ordinal='11' />
            <column datatype='string' name="sponsor" ordinal='12' />
            <column datatype='string' name="study_url" ordinal='13' />
            <column datatype='string' name="match_reasons" ordinal='14' />
            <column datatype='string' name="review_flags" ordinal='15' />
            <column datatype='integer' name="patient_rank" ordinal='16' />
            <column datatype='string' name="AI_Predicted_Condition" ordinal='17' />
            <column datatype='integer' name="Patient_Age" ordinal='18' />
            <column datatype='string' name="Patient_Sex" ordinal='19' />
            <column datatype='string' name="Patient_Location" ordinal='20' />
            <column datatype='string' name="Disease_Setting" ordinal='21' />
            <column datatype='string' name="Biomarker_EGFR" ordinal='22' />
            <column datatype='string' name="Biomarker_IDH" ordinal='23' />
            <column datatype='string' name="Biomarker_MGMT" ordinal='24' />
            <column datatype='string' name="site_city" ordinal='25' />
            <column datatype='string' name="site_state" ordinal='26' />
            <column datatype='string' name="site_country" ordinal='27' />
            <column datatype='string' name="distance" ordinal='28' />
          </columns>
        </relation>
      </connection>
      <aliases enabled='yes' />
      <column caption='Selected Patient' datatype='boolean' name='[Selected Patient]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Patient_ID] = [Parameters].[Parameter 1]' />
      </column>
      <column caption='Patient Summary' datatype='string' name='[Patient Summary]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[AI_Predicted_Condition] + &quot;  |  Age &quot; + STR([Patient_Age]) + &quot;  |  &quot; + [Patient_Sex] + &quot;  |  &quot; + [Patient_Location] + &quot;  |  &quot; + [Disease_Setting] + &quot;  |  EGFR &quot; + [Biomarker_EGFR] + &quot;  |  IDH &quot; + [Biomarker_IDH] + &quot;  |  MGMT &quot; + [Biomarker_MGMT]' />
      </column>
      <column caption='Candidates' datatype='integer' name='[Candidates]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([nct_id] + [Patient_ID])' />
      </column>
      <column caption="Rank" datatype='integer' name='[patient_rank]' role='dimension' type='ordinal' />
      <column caption="Score" datatype='integer' name='[match_score]' role='dimension' type='ordinal' />
      <column caption="Tier" datatype='string' name='[match_tier]' role='dimension' type='nominal' />
      <column caption="Trial" datatype='string' name='[trial_title]' role='dimension' type='nominal' />
      <column caption="NCT ID" datatype='string' name='[nct_id]' role='dimension' type='nominal' />
      <column caption="Status" datatype='string' name='[status]' role='dimension' type='nominal' />
      <column caption="Nearest site" datatype='string' name='[best_site]' role='dimension' type='nominal' />
      <column caption="Why it matches" datatype='string' name='[match_reasons]' role='dimension' type='nominal' />
      <column caption="Patient" datatype='string' name='[Patient_ID]' role='dimension' type='nominal' />
      <column caption="Distance" datatype='string' name='[distance]' role='dimension' type='nominal' />
      <column caption="City" datatype='string' name='[site_city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column caption="State" datatype='string' name='[site_state]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
      <column caption="Country" datatype='string' name='[site_country]' role='dimension' semantic-role='[Country].[Name]' type='nominal' />
      <column caption='Candidates' datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
        <calculation class='tableau' formula='1' />
      </column>
      <column-instance column='[match_tier]' derivation='None' name='[none:match_tier:nk]' pivot='key' type='nominal' />

      <extract count='-1' enabled='true' units='records'>
        <connection access_mode='readonly' author-locale='en_US' class='hyper' dbname="C:/Users/deipt/Downloads/Elif/hippocrates/Hippocrates-Analytics-Clinical-Trial-Matching-Optimization-main/tableau/trial_scout.hyper" default-settings='hyper' schema='Extract' sslmode='' tablename='Extract' username='tableau_internal_user'>
          <relation name='Extract' table='[Extract].[Extract]' type='table' />
        </connection>
      </extract>
      <layout dim-ordering='alphabetic' dim-percentage='0.5' measure-ordering='alphabetic' measure-percentage='0.4' show-structure='true' />
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:match_tier:nk]' type='palette'>
          <map to='#184f95'>
            <bucket>&quot;Strong&quot;</bucket>
          </map>
          <map to='#3987e5'>
            <bucket>&quot;Good&quot;</bucket>
          </map>
          <map to='#86b6ef'>
            <bucket>&quot;Possible&quot;</bucket>
          </map>
          </encoding>
        </style-rule>
      </style>

    </datasource>
