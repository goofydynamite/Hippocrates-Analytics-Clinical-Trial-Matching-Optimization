    <worksheet name="Patient Numbers">
      <table>
        <view>
          <datasources>
            <datasource caption='Patient Numbers' name='federated.patient_stats' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Patient' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;PID-001&quot;'>
              <calculation class='tableau' formula='&quot;PID-001&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.patient_stats'>
            <column caption="Patient" datatype='string' name='[Patient_ID]' role='dimension' type='nominal' />
            <column caption='Selected Patient' datatype='boolean' name='[Selected Patient]' role='dimension' type='nominal'><calculation class='tableau' formula='[Patient_ID] = [Parameters].[Parameter 1]' /></column>
            <column caption="Number" datatype='string' name='[stat]' role='dimension' type='nominal' />
            <column caption='Value' datatype='integer' name='[value]' role='measure' type='quantitative' />
            <column-instance column='[Selected Patient]' derivation='None' name='[none:Selected Patient:nk]' pivot='key' type='nominal' />
            <column-instance column='[stat]' derivation='None' name='[none:stat:nk]' pivot='key' type='nominal' />
            <column-instance column='[value]' derivation='Sum' name='[sum:value:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.patient_stats].[none:Selected Patient:nk]'>
            <groupfilter function='member' level='[none:Selected Patient:nk]' member='true' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <sort class='manual' column='[federated.patient_stats].[none:stat:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Candidate trials&quot;</bucket>
              <bucket>&quot;Strong matches&quot;</bucket>
              <bucket>&quot;With a site in their city&quot;</bucket>
              <bucket>&quot;Best score&quot;</bucket>
            </dictionary>
          </sort>
          <slices>
            <column>[federated.patient_stats].[none:Selected Patient:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='font-size' value='22' />
            <format attr='font-weight' value='bold' />
            <format attr='color' value='#184f95' />
            <format attr='width' field='[federated.patient_stats].[none:stat:nk]' value='290' />
          </style-rule>
          <style-rule element='worksheet'>
            <format attr='display-field-labels' scope='cols' value='false' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column='[federated.patient_stats].[sum:value:qk]' />
            </encodings>

          </pane>
        </panes>
        <rows></rows>
        <cols>[federated.patient_stats].[none:stat:nk]</cols>
      </table>
    </worksheet>
    <worksheet name="Trials by Phase">
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#184f95' fontsize='13'>Open trials by phase</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Phases' name='federated.phases' />
          </datasources>
          <datasource-dependencies datasource='federated.phases'>
            <column caption="Phase" datatype='string' name='[phase]' role='dimension' type='nominal' />
            <column caption="Open trials" datatype='integer' name='[open_trials]' role='measure' type='quantitative' />
            <column-instance column='[phase]' derivation='None' name='[none:phase:nk]' pivot='key' type='nominal' />
            <column-instance column='[open_trials]' derivation='Sum' name='[sum:open_trials:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <sort class='manual' column='[federated.phases].[none:phase:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Early phase 1&quot;</bucket>
              <bucket>&quot;Phase 1&quot;</bucket>
              <bucket>&quot;Phase 1/2&quot;</bucket>
              <bucket>&quot;Phase 2&quot;</bucket>
              <bucket>&quot;Phase 2/3&quot;</bucket>
              <bucket>&quot;Phase 3&quot;</bucket>
              <bucket>&quot;Phase 4&quot;</bucket>
              <bucket>&quot;Not applicable&quot;</bucket>
            </dictionary>
          </sort>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <text column='[federated.phases].[sum:open_trials:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-color' value='#3987e5' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.phases].[none:phase:nk]</rows>
        <cols>[federated.phases].[sum:open_trials:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="First Version Statuses">
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#184f95' fontsize='13'>What the first version's matches were (blue: a patient can still join)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='First Version Statuses' name='federated.legacy_status' />
          </datasources>
          <datasource-dependencies datasource='federated.legacy_status'>
            <column caption="Trial status" datatype='string' name='[status_label]' role='dimension' type='nominal' />
            <column caption="Can a patient join?" datatype='string' name='[can_join]' role='dimension' type='nominal' />
            <column caption="Matches" datatype='integer' name='[matches]' role='measure' type='quantitative' />
            <column-instance column='[status_label]' derivation='None' name='[none:status_label:nk]' pivot='key' type='nominal' />
            <column-instance column='[can_join]' derivation='None' name='[none:can_join:nk]' pivot='key' type='nominal' />
            <column-instance column='[matches]' derivation='Sum' name='[sum:matches:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <sort class='manual' column='[federated.legacy_status].[none:status_label:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Completed&quot;</bucket>
              <bucket>&quot;Recruiting&quot;</bucket>
              <bucket>&quot;Terminated&quot;</bucket>
              <bucket>&quot;Status unknown&quot;</bucket>
              <bucket>&quot;Active, not recruiting&quot;</bucket>
              <bucket>&quot;Not yet recruiting&quot;</bucket>
              <bucket>&quot;Withdrawn&quot;</bucket>
              <bucket>&quot;Suspended&quot;</bucket>
              <bucket>&quot;By invitation&quot;</bucket>
              <bucket>&quot;No longer available&quot;</bucket>
              <bucket>&quot;Expanded access&quot;</bucket>
            </dictionary>
          </sort>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.legacy_status].[none:can_join:nk]' />
              <text column='[federated.legacy_status].[sum:matches:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.legacy_status].[none:status_label:nk]</rows>
        <cols>[federated.legacy_status].[sum:matches:qk]</cols>
      </table>
    </worksheet>
  </worksheets>
